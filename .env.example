# Shared production locker. Leave empty to use the built-in PGLite demo database.
# For every store to see the same scores, set this to one Postgres URL (Neon, etc.)
# and deploy ONE copy of the site.
DATABASE_URL=

# Better Auth — required for Sign in on a real deploy.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Commissioner desk password. Required for any commissioner action (add/remove
# staff, lock weeks, reset the circuit, override scores). Pick a long, unique
# value — this is never sent to the browser, only checked server-side. With
# no value set, commissioner actions are disabled entirely.
DESK_PIN=

# Public host for OG images (no protocol). Example: rumble.yourstores.com
VITE_PUBLIC_HOSTNAME=
